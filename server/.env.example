PORT=5000
NODE_ENV=development

# Database: sqlite (default dev) atau mysql
DB_DIALECT=sqlite
DB_STORAGE=../database/dev.sqlite

# DB_DIALECT=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=monitoring_siswa
# DB_USER=root
# DB_PASSWORD=

JWT_SECRET=ganti_dengan_secret_panjang
JWT_EXPIRES_IN=12h

# Fonnte WhatsApp (token & nomor tujuan default)
FONNTE_TOKEN=
FONNTE_URL=https://api.fonnte.com/send
APP_DOMAIN=http://localhost:5173

# Path penyimpanan upload relatif ke server/
UPLOAD_DIR=../uploads
