PORT=5000
NODE_ENV=development

# Demo lokal: tampilkan kredensial demo di frontend bila VITE_DEMO_MODE=true
DEMO_MODE=true

# Database: sqlite (default dev) atau mysql
DB_DIALECT=sqlite
DB_STORAGE=../database/dev.sqlite

# DB_DIALECT=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=monitoring_siswa
# DB_USER=monitoring_app
# DB_PASSWORD=GANTI_PASSWORD_DB

# Wajib minimal 32 karakter acak di produksi.
JWT_SECRET=ganti_dengan_secret_acak_minimal_32_karakter
JWT_EXPIRES_IN=12h
JWT_ISSUER=monitoring-siswa
JWT_AUDIENCE=monitoring-siswa-web

# Fonnte WhatsApp (kosongkan untuk demo offline)
FONNTE_TOKEN=
FONNTE_URL=https://api.fonnte.com/send

# Domain frontend (untuk CORS & link notifikasi)
APP_DOMAIN=http://localhost:5173
# Bisa lebih dari satu, dipisah koma
CORS_ORIGIN=http://localhost:5173

# Kosong = tidak memakai reverse proxy. Isi 1 jika di belakang Nginx.
TRUST_PROXY=

# Path penyimpanan upload relatif ke folder server/
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=5242880
# Folder backup relatif ke folder server/
BACKUP_DIR=backups
