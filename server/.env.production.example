# =====================================================
# Contoh konfigurasi PRODUKSI untuk server
# Salin ke server Anda sebagai file .env
# JANGAN commit secret asli ke git.
# =====================================================
PORT=5000
NODE_ENV=production

# Jangan pernah mengaktifkan mode demo di produksi.
DEMO_MODE=false

# Database MySQL
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=monitoring_siswa
DB_USER=monitoring_app
DB_PASSWORD=GANTI_DENGAN_PASSWORD_DB_KUAT

# Mode migrasi: JANGAN pakai auto-sync di produksi.
# Buat/migrasi skema manual lewat: npm run db:migrate
DB_SYNC=none

# GANTI dengan string acak minimal 32 karakter.
# Di mode produksi, server MENOLAK berjalan jika secret ini
# masih berupa default atau kurang dari 32 karakter.
JWT_SECRET=GANTI_DENGAN_STRING_ACAK_PANJANG_SANGAT_RAHASIA_1234567890
JWT_EXPIRES_IN=12h
JWT_ISSUER=monitoring-siswa
JWT_AUDIENCE=monitoring-siswa-web

# Fonnte WhatsApp. Token yang pernah masuk repo publik WAJIB dirotasi.
FONNTE_TOKEN=
FONNTE_URL=https://api.fonnte.com/send

# Domain frontend (untuk CORS & link notifikasi)
APP_DOMAIN=https://monitoring.sdn4keling.sch.id
CORS_ORIGIN=https://monitoring.sdn4keling.sch.id

# Isi 1 jika server berada di belakang reverse proxy (Nginx/Caddy).
TRUST_PROXY=1

# Path penyimpanan upload relatif ke folder server/
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=5242880
# Simpan backup di luar folder aplikasi bila memungkinkan (relatif ke server/).
BACKUP_DIR=backups
