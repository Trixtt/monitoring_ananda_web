# =====================================================
# Contoh konfigurasi PRODUKSI untuk server
# Salin ke server Anda sebagai file .env
# JANGAN commit secret asli ke git.
# =====================================================
PORT=5000
NODE_ENV=production

# Database MySQL
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=monitoring_siswa
DB_USER=root
DB_PASSWORD=GANTI_DENGAN_PASSWORD_DB

# Mode migrasi: JANGAN pakai auto-sync di produksi.
# Buat/migrasi skema manual lewat: npm run db:migrate
DB_SYNC=none

# GANTI dengan string acak minimal 32 karakter.
# Di mode produksi, server MENOLAK berjalan jika secret ini
# masih berupa default atau kurang dari 32 karakter.
JWT_SECRET=GANTI_DENGAN_STRING_ACAK_PANJANG_SANGAT_RAHASIA_1234567890
JWT_EXPIRES_IN=12h

# Fonnte WhatsApp (token & nomor tujuan default)
FONNTE_TOKEN=GANTI_DENGAN_TOKEN_FONNTE
FONNTE_URL=https://api.fonnte.com/send

# Domain frontend (untuk CORS & link notifikasi)
APP_DOMAIN=https://monitoring.sdn4keling.sch.id

# Path penyimpanan upload relatif ke server/
UPLOAD_DIR=../uploads
