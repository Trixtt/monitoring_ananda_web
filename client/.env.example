# URL publik aplikasi (dipakai untuk canonical, OG, robots, sitemap)
VITE_SITE_URL=http://localhost:5173

# Tampilkan kredensial demo di halaman login (HANYA untuk demo lokal).
VITE_DEMO_MODE=true

# Opsional: origin API bila frontend dan backend berbeda origin.
# Kosongkan bila memakai proxy /api pada origin yang sama.
# VITE_API_ORIGIN=https://monitoring.sdn4keling.sch.id

# Target API saat `npm run dev` (dipakai proxy Vite).
VITE_DEV_API_TARGET=http://localhost:5000
